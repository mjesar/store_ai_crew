# Copy this file to .env and fill in the values. Never commit .env.

# Encrypts the credentials n8n saves (Slack, Shopify).
# Generate once with: openssl rand -hex 32
# Keep a copy in a password manager. The server needs the same value.
N8N_ENCRYPTION_KEY=

# Shopify dev store subdomain, without .myshopify.com.
SHOPIFY_STORE=
# Dev Dashboard > Apps > Store AI Crew > Settings > Credentials.
# Used for the client credentials grant (24 hour Admin API tokens) and to verify webhook signatures.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Lets the cloudflared container run the tunnel store-ai-crew (hooks.mjesar.dpdns.org), D19.
# Get it with: cloudflared tunnel token store-ai-crew
# It is the tunnel's key: anyone holding it can serve that address. The server needs the same value.
TUNNEL_TOKEN=

# Public base address n8n uses to build webhook URLs (behind the Cloudflare Tunnel). Not secret.
# Keep the trailing slash. WEBHOOK_URL is the old name, deprecated since n8n 2.35.
N8N_WEBHOOK_URL=https://hooks.mjesar.dpdns.org/
# One proxy (cloudflared) sits in front of n8n, so trust its X-Forwarded-* headers.
N8N_PROXY_HOPS=1
